generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  telegramId    BigInt         @unique
  username      String?
  firstName     String
  lastName      String?
  avatarUrl     String?
  role                 Role           @default(POSTER)
  isActive             Boolean        @default(true)
  notificationsEnabled Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  status        UserStatus     @default(PENDING)
  activities    ActivityLog[]
  approvedAds   Ad[]           @relation("ApprovedAds")
  assignedAds   Ad[]           @relation("AssignedAds")
  createdAds    Ad[]           @relation("CreatedAds")
  chatMessages  ChatMessage[]
  notifications Notification[]
}

model Channel {
  id              String   @id @default(cuid())
  name            String
  username        String   @unique
  category        String?
  description     String?
  subscriberCount Int      @default(0)
  isActive        Boolean  @default(true)
  preferredSlots  String[]
  color           String   @default("#3B82F6")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ads             Ad[]
}

model Ad {
  id                String         @id @default(cuid())
  title             String
  content           String
  mediaUrls         String[]
  advertiserName    String
  advertiserContact String?
  advertiserEmail   String?
  channelId         String
  durationDays      Int            @default(1)
  startDate         DateTime?
  scheduledAt       DateTime?
  postedAt          DateTime?
  expiresAt         DateTime?
  status            AdStatus       @default(DRAFT)
  assignedToId      String?
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  templateId        String?
  revenue           Decimal?       @db.Decimal(12, 2)
  currency          String         @default("ETB")
  notes             String?
  rejectionReason   String?
  groupId           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  activities        ActivityLog[]
  approvedBy        User?          @relation("ApprovedAds", fields: [approvedById], references: [id])
  assignedTo        User?          @relation("AssignedAds", fields: [assignedToId], references: [id])
  channel           Channel        @relation(fields: [channelId], references: [id])
  createdBy         User           @relation("CreatedAds", fields: [createdById], references: [id])
  template          Template?      @relation(fields: [templateId], references: [id])
  chatMessages      ChatMessage[]
  notifications     Notification[]
}

model Template {
  id              String   @id @default(cuid())
  name            String
  content         String
  mediaUrls       String[]
  advertiserName  String?
  defaultDuration Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ads             Ad[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  adId      String?
  action    String
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())
  ad        Ad?      @relation(fields: [adId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([adId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  adId      String?
  isRead    Boolean          @default(false)
  sentTg    Boolean          @default(false)
  createdAt DateTime         @default(now())
  ad        Ad?              @relation(fields: [adId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model ChatMessage {
  id        String   @id @default(cuid())
  adId      String
  userId    String
  content   String
  createdAt DateTime @default(now())
  ad        Ad       @relation(fields: [adId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([adId])
}

enum Role {
  ADMIN
  MANAGER
  POSTER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum AdStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT
  REMINDER
  EXPIRY_WARNING
  DAILY_SUMMARY
  STATUS_CHANGE
  APPROVAL_REQUEST
  APPROVAL_GRANTED
  APPROVAL_REJECTED
}
