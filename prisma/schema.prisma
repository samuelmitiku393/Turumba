// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  POSTER
}

enum AdStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  POSTED
  ACTIVE
  EXPIRED
  CANCELLED
  REJECTED
}

enum NotificationType {
  ASSIGNMENT
  REMINDER
  EXPIRY_WARNING
  DAILY_SUMMARY
  STATUS_CHANGE
  APPROVAL_REQUEST
  APPROVAL_GRANTED
  APPROVAL_REJECTED
}

model User {
  id            String   @id @default(cuid())
  telegramId    BigInt   @unique
  username      String?
  firstName     String
  lastName      String?
  avatarUrl     String?
  role          Role     @default(POSTER)
  isActive      Boolean  @default(true)
  notifyAssign  Boolean  @default(true)
  notifyRemind  Boolean  @default(true)
  notifyExpiry  Boolean  @default(true)
  notifyDigest  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedAds   Ad[]          @relation("AssignedAds")
  createdAds    Ad[]          @relation("CreatedAds")
  approvedAds   Ad[]          @relation("ApprovedAds")
  activities    ActivityLog[]
  notifications Notification[]
  chatMessages  ChatMessage[]
}

model Channel {
  id              String   @id @default(cuid())
  name            String
  username        String   @unique
  category        String?
  description     String?
  subscriberCount Int      @default(0)
  isActive        Boolean  @default(true)
  maxPostsPerDay  Int      @default(5)
  preferredSlots  String[] // ["09:00", "18:00"]
  color           String   @default("#3B82F6") // for calendar display
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ads             Ad[]
}

model Ad {
  id                  String    @id @default(cuid())
  title               String
  content             String
  mediaUrls           String[]
  advertiserName      String
  advertiserContact   String?
  advertiserEmail     String?
  channelId           String
  channel             Channel   @relation(fields: [channelId], references: [id])
  durationDays        Int       @default(1)
  startDate           DateTime?
  scheduledAt         DateTime?
  postedAt            DateTime?
  expiresAt           DateTime?
  status              AdStatus  @default(DRAFT)
  assignedToId        String?
  assignedTo          User?     @relation("AssignedAds", fields: [assignedToId], references: [id])
  createdById         String
  createdBy           User      @relation("CreatedAds", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?     @relation("ApprovedAds", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  templateId          String?
  template            Template? @relation(fields: [templateId], references: [id])
  revenue             Decimal?  @db.Decimal(12, 2)
  currency            String    @default("ETB")
  notes               String?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  chatMessages        ChatMessage[]
  activities          ActivityLog[]
  notifications       Notification[]
}

model Template {
  id              String   @id @default(cuid())
  name            String
  content         String
  mediaUrls       String[]
  advertiserName  String?
  defaultDuration Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ads             Ad[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  adId      String?
  ad        Ad?      @relation(fields: [adId], references: [id])
  action    String   // "created_ad" | "status_changed" | "assigned" | "posted" | "approved" | etc.
  oldValue  String?
  newValue  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  adId      String?
  ad        Ad?              @relation(fields: [adId], references: [id])
  isRead    Boolean          @default(false)
  sentTg    Boolean          @default(false) // whether Telegram message was sent
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model ChatMessage {
  id        String   @id @default(cuid())
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([adId])
}
