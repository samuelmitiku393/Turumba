# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Railway, Render, etc.)
DATABASE_URL=postgresql://user:password@host:5432/turumba?sslmode=require

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Cloudinary (media uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# URL where the frontend is deployed (for CORS)
FRONTEND_URL=http://localhost:5173
# URL where the backend is deployed (needed by bot & frontend)
BACKEND_URL=http://localhost:4000

# ─── Mini App ────────────────────────────────────────────────
# The URL of your deployed Mini App (set this after deploying frontend)
MINI_APP_URL=https://your-app.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
